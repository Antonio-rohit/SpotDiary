# =============================================================
# SpotDiary Monorepo Environment Variables Reference (.env.example)
# =============================================================
# SpotDiary uses separate environment files for each app:
# - Web & Backend: apps/web/.env.example -> apps/web/.env.local
# - Mobile Client: apps/mobile/.env.example -> apps/mobile/.env.local
#
# NEVER commit .env or .env.local files containing real credentials.
# =============================================================

# --- Backend Configuration (apps/web/.env.local) ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/spotdiary
JWT_SECRET=your-secure-jwt-secret-minimum-32-chars-long
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Optional Production / Staging Services ---
# STORAGE_TYPE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=SpotDiary <noreply@yourdomain.com>

# --- Mobile Client Configuration (apps/mobile/.env.local) ---
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
