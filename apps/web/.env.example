# =============================================================
# SpotDiary Web & API Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to source control.
# =============================================================

# Server Port and Node Environment
PORT=3000
NODE_ENV=development

# Canonical Public Application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection
# Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/spotdiary
# Production / Staging Atlas Cluster:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/spotdiary?retryWrites=true&w=majority&maxPoolSize=20

# JWT Cryptographic Secret (Minimum 32 random characters in production)
# Generate via: openssl rand -hex 32
JWT_SECRET=your-secure-jwt-secret-minimum-32-chars-long

# Google Places API (New) Key (Server-Side Only; NEVER expose with NEXT_PUBLIC_)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Persistent Object Storage (Optional for local dev, mandatory for production/staging)
# STORAGE_TYPE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Transactional Email Delivery (Optional for local dev, mandatory for production/staging)
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=SpotDiary <noreply@yourdomain.com>
# Or SMTP:
# SMTP_HOST=smtp.yourprovider.net
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
