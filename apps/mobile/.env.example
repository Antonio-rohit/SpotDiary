# =============================================================
# SpotDiary Mobile Client Environment Variables (.env.example)
# Copy this file to .env or .env.local in apps/mobile for development.
# NEVER place backend secrets (JWT_SECRET, MONGODB_URI, AWS, etc.) here.
# =============================================================

# SpotDiary Backend API Base URL
# - Local Android Emulator: http://10.0.2.2:3000
# - Local iOS Simulator / Web: http://localhost:3000
# - Physical Android / iOS Phone on LAN: http://<YOUR_LAN_IP>:3000 (e.g. http://192.168.1.50:3000)
# - Staging / Production Backend: https://staging.spotdiary.app
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
